# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Staging/production values are set in the Render dashboard.

# Local dev: turn on debug. Staging/production: False (render.yaml sets it).
DEBUG=True

# Any long random string. Render generates one automatically.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Postgres connection URL. Leave unset locally to use SQLite (DEBUG=True only).
# Neon example: postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noble_shape

# Comma-separated. Render's own hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Render's own https origin is added automatically.
CSRF_TRUSTED_ORIGINS=

# Grader account passwords, read by `python manage.py seed`.
# Required whenever DEBUG is off (staging, production, CI). Set the real values
# in the Render dashboard only; the submission notes carry them, git never does.
# Locally with DEBUG=True you can leave these unset: seed falls back to an
# obvious dev-only default.
# SEED_ADMIN_PASSWORD=
# SEED_STUDENT_PASSWORD=

# Optional
LOG_LEVEL=INFO
# OPENROUTER_API_KEY=   # needed from Sprint 2 (AI feature)
